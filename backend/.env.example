# Bitfuse Django Backend Environment Variables

# Django Core
DEBUG=False
SECRET_KEY=change-me-bitfuse-secret-key-32bytes-minimum-length
JWT_SECRET_KEY=change-me-bitfuse-secret-key-32bytes-minimum-length

# Database
# Example PostgreSQL: postgres://postgres:password@db:5432/bitfuse
# Example SQLite: sqlite:////app/Bitfuse/db.sqlite3
DATABASE_URL=sqlite:////app/Bitfuse/db.sqlite3

# External Blnk Integration
BLNK_BASE_URL=https://bitfuse-blnk-server-qfn2.onrender.com
BLNK_SECRET_KEY=

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=https://bitfuse-mw.vercel.app,http://localhost:3000

# Session Security Policies
SESSION_INACTIVITY_TIMEOUT_MINUTES=15
SESSION_MAX_LIFETIME_HOURS=24

# File Storage (S3/MinIO or Local)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Bitfuse <noreply@bitfuse.app>

# SMS Settings
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
