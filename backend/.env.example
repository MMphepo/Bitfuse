# Bitfuse Django Backend Environment Variables

# Django Core
DEBUG=False
SECRET_KEY=change-me-bitfuse-secret-key-32bytes-minimum-length
JWT_SECRET_KEY=change-me-bitfuse-secret-key-32bytes-minimum-length

# Database
# Example PostgreSQL: postgres://postgres:password@db:5432/bitfuse
# Example SQLite: sqlite:////app/Bitfuse/db.sqlite3
DATABASE_URL=sqlite:////app/Bitfuse/db.sqlite3

# External Blnk Integration
BLNK_BASE_URL=https://bitfuse-blnk-server-qfn2.onrender.com
BLNK_API_KEY=

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=https://bitfuse-mw.vercel.app,http://localhost:3000

# Session Security Policies
SESSION_INACTIVITY_TIMEOUT_MINUTES=15
SESSION_MAX_LIFETIME_HOURS=24

# File Storage (S3/MinIO or Local)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Email / Coolhost SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@bitfuse.mw
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bitfuse <support@bitfuse.mw>
FRONTEND_URL=https://bitfuse.mw
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_REQUESTS_PER_HOUR=5

# SMS & TumaSend Configuration
SMS_PROVIDER=tumasend
TUMASEND_API_URL=https://gateway.tumasend.com
TUMASEND_API_KEY=your-tumasend-api-key
TUMASEND_SENDER_ID=Bitfuse
PHONE_VERIFICATION_OTP_EXPIRY_SECONDS=300
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PHONE_VERIFICATION_MAX_SENDS_PER_HOUR=5
PHONE_VERIFICATION_MAX_SENDS_PER_DAY=10

# Google OAuth Configuration
GOOGLE_CLIENT_ID=50963774471-dnqglh5mpe7s0bh6r3li3tdr1o31fibf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 Configuration (Disabled)
RECAPTCHA_ENABLED=False
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_SCORE_THRESHOLD_FINANCIAL=0.7
RECAPTCHA_ALLOWED_HOSTNAMES=bitfuse.mw,www.bitfuse.mw
